# SautiCivic Bridge — Environment Variables
# Copy this to .env and fill in real values.

# --- Gate thresholds ---
# Re-derive these empirically when swapping mock classifier for real LLM backend.
GATE_MIN_CLASSIFICATION_CONFIDENCE=0.70
GATE_MIN_ENTITY_CONFIDENCE=0.60
GATE_MAX_CLARIFICATION_ROUNDS=3

# --- Database ---
DATABASE_URL=postgresql://sauticivic:sauticivic@localhost:5432/sauticivic

# --- ASR API keys ---
# Leave blank to use mock pipeline (no real ASR).
SAHARA_API_KEY=
SAHARA_API_URL=https://infer.voice.intron.io/file/v1/upload/sync
DEEPGRAM_API_KEY=
GEMINI_API_KEY=
# Optional. Server-side only; do not add this to Vite/browser environment variables.
DEEPSEEK_API_KEY=
WHISPER_MODEL_SIZE=large-v3

# --- Benchmark ---
BENCHMARK_CLIP_DELAY_MS=200

# --- Server ---
HOST=0.0.0.0
PORT=8000
DEBUG=false
